; Saeed Royale — standalone 3D survival shooter
config_version=5

[application]
config/name="Adam Royal"
run/main_scene="res://main.tscn"
config/description="Adam Royal — a standalone 3D battle royale survival game."

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.36, 0.57, 0.72, 1)

