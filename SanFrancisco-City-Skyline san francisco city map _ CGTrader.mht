.asset-item { position: static; overflow: visible; display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 45px; width: 100%; padding: 14px 12px; gap: 4px; border-bottom: 1px solid rgba(39, 44, 48, 0.12); box-sizing: border-box; }

.asset-item__link { display: flex; align-items: center; width: 100%; color: rgb(34, 34, 34); text-decoration: none; gap: 12px; }

.asset-item__title { flex: 1 1 0%; font-size: 14px; font-weight: 600; color: rgb(53, 66, 79); display: flex; align-items: center; min-width: 0px; }

.asset-item:hover, .asset-item:focus { background: var(--state-hover, rgba(39,44,48,0.1)); outline: none; }

@media (min-width: 960px) {
  .asset-item { gap: 12px; position: relative; }
}

.asset-item.asset-item--hidden { display: none; }

.subcategory-menu { position: absolute; overflow: visible; left: calc(100% + 5px); top: 5px; z-index: 1001; min-width: 180px; padding: 8px 0px; background: rgb(255, 255, 255); border: 1px solid rgb(210, 213, 216); border-radius: 8px; box-shadow: rgba(18, 20, 20, 0.03) 0px 1.44px 1.55px, rgba(18, 20, 20, 0.05) 0px 3.65px 3.91px; display: none; opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s 0.3s; }

.subcategory-menu--open { display: block; opacity: 1; visibility: visible; transition-delay: 0s; }

.subcategory-menu::before { content: ""; position: absolute; top: 0px; left: -5px; width: 5px; height: 100%; background: transparent; pointer-events: all; }

.subcategory-menu__header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 16px; }

.subcategory-menu__header-content { display: flex; flex-direction: row; align-items: center; gap: 8px; }

.subcategory-menu__header-title { color: rgb(53, 66, 79); text-transform: uppercase; }

.subcategory-menu__list { margin: 0px; padding: 0px; list-style: none; height: 100%; overflow-y: auto; }

@media (min-width: 640px) {
  .subcategory-menu__list { min-height: 100px; max-height: 400px; overflow-y: auto; }
}

.subcategory-menu__item { margin: 0px; padding: 0px; }

.subcategory-menu__link { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 16px; margin: 0px 4px; color: rgb(34, 34, 34); white-space: normal; cursor: pointer; text-decoration: none; transition: background-color 0.2s; border-bottom: 1px solid rgb(240, 240, 240); }

.subcategory-menu__link:hover { background: rgba(39, 44, 48, 0.1); border-radius: 6px; }

@media (max-width: 959.98px) {
  .subcategory-menu { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; border-radius: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: rgb(255, 255, 255); z-index: 1002; }
  .subcategory-menu::before { display: none; }
}

@media (min-width: 960px) {
  .subcategory-menu__header { display: none; }
  .subcategory-menu__link { padding: 10px 20px; white-space: nowrap; border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }
  .subcategory-menu__link-icon { display: none; }
}

@media (min-width: 1280px) {
