.cgt-menu-item__lead-icon { left: 8px; }

.cgt-menu-item__trail-icon { right: 8px; }

.cgt-menu-item__lead-icon .fillable, .cgt-menu-item__trail-icon .fillable { fill: rgba(30, 39, 50, 0.6); }

